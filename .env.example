# ===============================================
# VEGA — variabili ambiente
# Copia in .env e compila con i tuoi valori
# NON committare mai il file .env reale
# ===============================================

# === OBBLIGATORI ===

# API key Anthropic (obbligatoria)
# Ottieni una a: https://console.anthropic.com
ANTHROPIC_API_KEY=

# === OPZIONALI ===

# Gmail per leggere/inviare mail (richiede app password)
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ElevenLabs per voice cloning premium (opzionale, ha free tier)
# https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Ollama host (default localhost)
OLLAMA_HOST=http://localhost:11434

# Modello locale Ollama da usare (default llama3.2:3b)
VEGA_LOCAL_MODEL=llama3.2:3b

# Abilita TLS self-signed (vedi data/cert/ generato auto)
# VEGA_TLS=1

# HuggingFace token (per evitare rate limiting su download modelli)
# https://huggingface.co/settings/tokens
HF_TOKEN=
